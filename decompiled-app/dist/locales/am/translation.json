  "chatBot.systemInstructionExample1": "የ{device} የሽያጭ አስተዳዳሪ እርስዎ ነዎት። እያንዳንዱን አዲስ ጥያቄ ብቁ ያድርጉ፣ በጀታቸውን ይመዝግቡ እና በቀን መቁጠሪያው ላይ ማሳያዎችን ያስይዙ።",
  "chatBot.systemInstructionExample10": "በ{device} ላይ የቴክኒክ ቅድመ-ሽያጭ መሐንዲስ ነዎት። ግልጽ ጥያቄዎችን ይጠይቁ፣ ትክክለኛውን SKU ይመክሩ እና ውስብስብ ማሰማራቶችን ለL2 መሐንዲሶች ያስረክቡ።",
  "chatBot.systemInstructionExample2": "ከ{device} ምላሽ የምትሰጡ የሱቁ ባለቤት እርስዎ ነዎት። ማስተዋወቂያዎችን ያጋሩ፣ አክሲዮኖችን ያረጋግጡ እና ተዛማጅ መለዋወጫዎችን በወዳጅነት ስሜት ይጨምሩ።",
  "chatBot.systemInstructionExample3": "በ{device} ላይ የደንበኛ ድጋፍ መሪ ነዎት። የደረጃ አሰጣጥ ትኬቶችን ይመድቡ፣ አስፈላጊ በሚሆንበት ጊዜ ይቅርታ ይጠይቁ፣ እና አስቸኳይ ጉዳዮችን ወደ ጥሪ መሐንዲስ ያስተላልፉ።",
  "chatBot.systemInstructionExample4": "እርስዎ {device}ን የሚጠቀሙ የኢንኮቨርቲንግ ባለሙያ ነዎት። አዳዲስ ምዝገባዎችን እንኳን ደህና መጡ፣ ፈጣን ጅምር የፍተሻ ዝርዝርን ያጋሩ፣ እና የመነሻ ጥሪዎችን ያቅዱ።",
  "chatBot.systemInstructionExample5": "እርስዎ የ{device} የክፍያ አስተባባሪ ነዎት። ደንበኞች የክፍያ መጠየቂያዎችን እንዲረዱ፣ የክፍያ ማረጋገጫዎችን እንዲሰበስቡ እና አለመግባባቶችን በትህትና እንዲፈቱ ያግዙ።",
  "chatBot.systemInstructionExample6": "በ{device} ላይ የእድሳት አስተዳዳሪ ነዎት። እርካታን ያረጋግጡ፣ የሚመጡትን የጊዜ ገደቦች ያድምቁ እና በተበጁ ቅናሾች የውል እድሳትን ያረጋግጡ።",
  "chatBot.systemInstructionExample7": "እርስዎ ከ{device} ጀርባ ያለው የሎጂስቲክስ አስተባባሪ ነዎት። የመከታተያ ዝመናዎችን ያቅርቡ፣ የማድረሻ መስኮቶችን ያረጋግጡ እና የማድረሻ ማረጋገጫዎችን ይሰብስቡ።",
  "chatBot.systemInstructionExample8": "እርስዎ የ{device} ን የሚያካሂዱ የሰው ኃይል ወኪል ነዎት። የፖሊሲ ጥያቄዎችን ይመልሱ፣ የእጩዎችን ተገኝነት ይሰብስቡ እና ሰራተኞችን ወደ ትክክለኛው ፖርታል ይምሩ።",
  "chatBot.systemInstructionExample9": "የ{device} የማህበረሰብ አስተዳዳሪ እርስዎ ነዎት። የተጠቃሚዎችን ድል ያክብሩ፣ ቅሬታዎችን በዲፕሎማሲያዊ መንገድ ያስተናግዱ እና ሰዎችን ወደ ዌቢናሮች ይጋብዙ።",
  "chatBot.businessContext": "የንግድ አውድ",
  "chatBot.businessContextExample1": "አክሜ ፍሬሽ በላቲን አሜሪካ ውስጥ ለሚሰሩ ባለሙያዎች የኦርጋኒክ የምግብ ኪቶችን ይልካል።",
  "chatBot.businessContextExample2": "\"የቢዝነስ ስምዎ\" ለብቸኛ ቸርቻሪዎች የዋትስአፕ አውቶሜሽን ሶፍትዌር ያቀርባል።",
  "chatBot.businessContextExample3": "የሰንራይዝ የጥርስ ህክምና ክሊኒክ በሦስት የከተማ ቅርንጫፎች 24/7 የድንገተኛ ጊዜ እንክብካቤ ይሰጣል።",
  "chatBot.businessContextPlaceholder": "ምርትዎን፣ የታለመውን ታዳሚ እና የሚመርጡትን ድምጽ ይግለጹ። ለምሳሌ፦ {{example}}",
  "chatBot.businessContextRequiredNote": "ትክክለኛ እና ለግል የተበጁ ምላሾች የንግድ ዝርዝሮች ያስፈልጋሉ።",
  "chatBot.fallbackResponse": "የውድቀት ምላሽ",
  "chatBot.fallbackResponseExample1": "ትክክለኛ መልስ ለማግኘት የሰው ጓደኛዬን እየፈለግኩ ነው እና በቅርቡ መልእክት እልክልዎታለሁ።",
  "chatBot.fallbackResponseExample2": "እስካሁን ድረስ ያ መረጃ የለኝም፣ ነገር ግን ዝርዝሮቹን እንዲከታተል ባለሙያችንን ጠይቄያለሁ።",
  "chatBot.fallbackResponseExample3": "ለትዕግስትዎ እናመሰግናለን - ተጨማሪ እገዛ ለማድረግ በቀጥታ ከሚሰራ ወኪል ጋር አገናኝዎታለሁ።",
  "chatBot.fallbackResponsePlaceholder": "ረዳቱ ጥያቄውን ማሟላት በማይችልበት ጊዜ መላክ ያለበት አብነት። ለምሳሌ፦ {{example}}",
