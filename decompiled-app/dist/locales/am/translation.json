  "chatBot.providerDescription.ai21": "ረጅም አውድ እና የመሳሪያ ጥሪ ያለው የጃምባ ድብልቅ-ኦፍ-ኤክስፐርቶች።",
  "chatBot.providerDescription.azureOpenAI": "የጂፒቲ ሞዴሎችን ከ Azure አስተዳደር፣ ክልሎች እና የተገዢነት ባህሪያት ጋር በኢንተርፕራይዝ ማሰማራት።",
  "chatBot.providerDescription.chatGPT": "ሙሉ ተግባር ጥሪ እና የJSON ንድፍ ድጋፍ ያላቸው የፍላጎት GPT-5 ክፍል አመክንዮ ሞዴሎች።",
  "chatBot.providerDescription.claude": "የክላውድ 3.5 ቤተሰብ በሕገ መንግሥታዊ ደህንነት እና በመልዕክቶች ኤፒአይ በኩል የJSON መሣሪያ አጠቃቀም።",
  "chatBot.providerDescription.cohere": "ረጅም አውዶችን የሚያውቅ የኮማንድ አር ቤተሰብ።",
  "chatBot.providerDescription.deepseek": "የDeepSeek Chat እና Reasoner ሞዴሎች ከተወዳዳሪ የወጪ እና የማመዛዘን ሰንሰለቶች ጋር።",
  "chatBot.providerDescription.fireworks": "እንደ FireFunction፣ Mixtral እና Lalama ላሉ ለተግባር ዝግጁ የሆኑ ሞዴሎች አገልጋይ-አልባ ግምት።",
  "chatBot.providerDescription.gemini": "የጀሚኒ 3 እና 2.5 ባለብዙ ሞዳል ሞዴሎች ከቀጥታ የደህንነት መቆጣጠሪያዎች ጋር።",
  "chatBot.providerDescription.grok": "ከOpenAI ጋር ተኳሃኝ የሆኑ የውይይት ማጠናቀቂያዎች ጋር የLatency-የተመቻቹ Grok-4 ሞዴሎች።",
  "chatBot.providerDescription.groq": "በግሮክ LPU በኩል ለላማ እና ለጌማ እጅግ በጣም ዝቅተኛ የዘገየ ማጠቃለያ።",
  "chatBot.providerDescription.llamaCloud": "በላማ ክላውድ / ላማ ስታክ ኤፒአይ በኩል የሚተዳደሩ የላማ 3.1 ማሰማራቶች።",
  "chatBot.providerDescription.mistral": "የሚክስትራል + ሚስትራል ቤተሰብ ከተስተናገደ የተግባር ጥሪ እና ዥረት ጋር።",
  "chatBot.providerDescription.moonshot": "ከ8ኬ–128ኬ አውድ ልዩነቶች ጋር በቻይና መሪ የሆነ የሙንሾት ረዳት።",
  "chatBot.providerDescription.openRouter": "ሜታ ገበያ በአንድ ኦፕንአይ-ተኳሃኝ ኤፒአይ በኩል ከ70 በላይ ሞዴሎችን መዳረሻ የሚሰጥ።",
  "chatBot.providerDescription.perplexity": "በድር ፍለጋዎች እና በOpenAI API እኩልነት የተደገፉ የፍለጋ መሰረት ያላቸው የሶናር ሞዴሎች።",
  "chatBot.providerDescription.qwen": "በዳሽስኮፕ በኩል 72ቢ/14ቢ/7ቢ አማራጮች ያላቸው የQwen2.5 የሁለት ቋንቋ ተናጋሪ ሞዴሎች።",
  "chatBot.providerDescription.togetherAI": "ከ100 በላይ የማህበረሰብ ሞዴሎችን በJSON የውጤት ሁነታ የሚያገለግል ከፍተኛ አፈጻጸም ያለው የግንዛቤ ክላስተር።",
  "chatBot.providerDescription.writer": "በአስተዳደር፣ በማስታወስ እና በአይቲ ጥበቃዎች የተገነቡ ለኢንተርፕራይዝ አስተማማኝ የሆኑ የፓልሚራ ሞዴሎች።",
  "chatBot.providerDescription.yi": "የዪ ተከታታይ አመክንዮ ሞዴሎች ከቻይንኛ + እንግሊዝኛ አቀላጥፈው።",
  "chatBot.providerDescription.zhipu": "የGLM-4 ስብስብ በሁለት ቋንቋ ጥንካሬዎች እና በJSON-ሞድ ማጠናቀቂያዎች።",
